---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { getCategories, getSortedPosts } from "@/lib/content/blog-utils";
import type { Page, PaginateFunction } from "astro";
import type { CollectionEntry } from "astro:content";

export async function getStaticPaths({ paginate }: { paginate: PaginateFunction }) {
  const categories = await getCategories();
  const allPosts = await getSortedPosts();

  // 为每个分类创建分页
  return categories.flatMap(([category]) => {
    const categoryPosts = allPosts.filter(post => post.data.category === category);
    return paginate(categoryPosts, {
      params: { slug: category, page: undefined },
      props: { category },
      pageSize: 6,
    });
  });
}

type Props = {
  page: Page<CollectionEntry<"blog">>;
  category: string;
};

const { page, category } = Astro.props;

function formatDate(date: Date) {
  return date.toLocaleDateString("zh-CN", {
    year: "numeric",
    month: "long",
    day: "numeric",
  });
}
---

<BaseLayout title={`${category} - 分类`} description={`${category}分类下的文章`}>
  <section class="mb-12">
    <a
      href="/category"
      class="text-muted-foreground hover:text-primary mb-4 inline-flex items-center transition-colors"
    >
      <svg class="mr-2 h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path>
      </svg>
      返回分类
    </a>
    <h1 class="mb-4 text-4xl font-bold">{category}</h1>
    <p class="text-muted-foreground">{page.total} 篇文章</p>
  </section>

  <section>
    <ul class="space-y-6">
      {
        page.data.map(post => (
          <li class="rounded-lg border p-6 transition-shadow hover:shadow-md">
            <a href={`/blog/${post.id}`} class="block">
              <h3 class="hover:text-primary mb-2 text-xl font-semibold">{post.data.title}</h3>
              <p class="text-muted-foreground mb-3">{post.data.description}</p>
              <time class="text-muted-foreground/80 text-sm">{formatDate(post.data.pubDate)}</time>
            </a>
          </li>
        ))
      }
    </ul>
  </section>

  <nav class="mt-12 flex justify-center gap-4">
    {
      page.url.prev ? (
        <a href={page.url.prev} class="bg-muted hover:bg-muted/80 rounded px-4 py-2">
          上一页
        </a>
      ) : null
    }
    <span class="px-4 py-2">
      {page.currentPage} / {page.lastPage}
    </span>
    {
      page.url.next ? (
        <a href={page.url.next} class="bg-muted hover:bg-muted/80 rounded px-4 py-2">
          下一页
        </a>
      ) : null
    }
  </nav>
</BaseLayout>
