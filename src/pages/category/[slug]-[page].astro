---
import Pagination from "@/components/Pagination.astro";
import PostList from "@/components/PostList.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { getCategories, getSortedPosts } from "@/lib/content/blog-utils";
import type { Page, PaginateFunction } from "astro";
import type { CollectionEntry } from "astro:content";

export async function getStaticPaths({ paginate }: { paginate: PaginateFunction }) {
  const categories = await getCategories();
  const allPosts = await getSortedPosts();

  // 为每个分类创建分页
  return categories.flatMap(([category]) => {
    const categoryPosts = allPosts.filter(post => post.data.category === category);
    return paginate(categoryPosts, {
      params: { slug: category, page: undefined },
      props: { category },
      pageSize: 6,
    });
  });
}

type Props = {
  page: Page<CollectionEntry<"blog">>;
  category: string;
};

const { page, category } = Astro.props;
---

<BaseLayout title={`${category} - 分类`} description={`${category}分类下的文章`}>
  <section class="mb-12">
    <a
      href="/category"
      class="text-muted-foreground hover:text-primary mb-4 inline-flex items-center transition-colors"
    >
      <svg class="mr-2 h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path>
      </svg>
      返回分类
    </a>
    <h1 class="mb-4 text-4xl font-bold">{category}</h1>
    <p class="text-muted-foreground">{page.total} 篇文章</p>
  </section>

  <PostList posts={page.data} showCategory={false} />

  <Pagination page={page} />
</BaseLayout>
