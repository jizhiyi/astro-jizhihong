---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { getCategories } from "@/lib/content/blog-utils";

const categories = await getCategories();
---

<BaseLayout title="分类" description="文章分类">
  <section class="mb-12">
    <h1 class="mb-4 text-4xl font-bold">文章分类</h1>
    <p class="text-muted-foreground">点击分类查看对应文章</p>
  </section>

  <section>
    <ul class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {
        categories.map(([name, count]) => (
          <li>
            <a href={`/category/${name}-1`} class="block rounded-lg border p-6 transition-shadow hover:shadow-md">
              <h2 class="mb-2 text-xl font-semibold">{name}</h2>
              <p class="text-muted-foreground">{count} 篇文章</p>
            </a>
          </li>
        ))
      }
    </ul>
  </section>
</BaseLayout>
