---
import BaseLayout from "@/layouts/BaseLayout.astro";
import "@/styles/typography.css";
import { getCollection, render, type CollectionEntry } from "astro:content";

type Props = {
  post: CollectionEntry<"blog">;
};

export async function getStaticPaths() {
  const posts = await getCollection("blog");
  return posts.map(post => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);

function formatDate(date: Date) {
  return date.toLocaleDateString("zh-CN", {
    year: "numeric",
    month: "long",
    day: "numeric",
  });
}
---

<BaseLayout title={post.data.title} description={post.data.description}>
  <article>
    <a href="/" class="hover:text-primary text-muted-foreground mb-6 inline-flex items-center transition-colors">
      <svg class="mr-2 h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path>
      </svg>
      返回文章列表
    </a>

    <header class="mb-8">
      {
        post.data.category && (
          <a
            href={`/category/${post.data.category}-1`}
            class="bg-muted text-muted-foreground hover:bg-muted/80 mb-4 inline-block rounded px-3 py-1 text-sm transition-colors"
          >
            {post.data.category}
          </a>
        )
      }
      <h1 class="mb-4 text-4xl font-bold">{post.data.title}</h1>
      <time class="text-muted-foreground/80">{formatDate(post.data.pubDate)}</time>
    </header>

    <div class="article-content">
      <Content />
    </div>
  </article>
</BaseLayout>
