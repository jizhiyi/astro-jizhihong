---
import BaseLayout from "@/layouts/BaseLayout.astro";
import type { Page, PaginateFunction } from "astro";
import type { CollectionEntry } from "astro:content";
import { getCollection } from "astro:content";

type Props = {
  page: Page<CollectionEntry<"blog">>;
};

export async function getStaticPaths({ paginate }: { paginate: PaginateFunction }) {
  const posts = (await getCollection("blog")).sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
  return paginate(posts, { pageSize: 6 });
}

const { page } = Astro.props;

function formatDate(date: Date) {
  return date.toLocaleDateString("zh-CN", {
    year: "numeric",
    month: "long",
    day: "numeric",
  });
}
---

<BaseLayout title="Astro Blog" description="我的技术博客">
  <section class="mb-12">
    <h1 class="mb-4 text-4xl font-bold">欢迎来到我的博客</h1>
    <p class="text-gray-600">分享技术笔记、生活感悟和学习心得</p>
  </section>

  <section>
    <ul class="space-y-6">
      {
        page.data.map(post => (
          <li class="rounded-lg border p-6 transition-shadow hover:shadow-md">
            <a href={`/blog/${post.id}`} class="block">
              <h3 class="mb-2 text-xl font-semibold hover:text-blue-600">{post.data.title}</h3>
              <p class="mb-3 text-gray-600">{post.data.description}</p>
              <div class="flex gap-4 text-sm text-gray-500">
                <time datetime={post.data.pubDate.toISOString()}>{formatDate(post.data.pubDate)}</time>
                {post.data.category && <span class="rounded bg-gray-100 px-2 py-1">{post.data.category}</span>}
              </div>
            </a>
          </li>
        ))
      }
    </ul>
  </section>

  <nav class="mt-12 flex justify-center gap-4">
    {
      page.url.prev ? (
        <a href={page.url.prev} class="rounded bg-gray-100 px-4 py-2 hover:bg-gray-200">
          上一页
        </a>
      ) : null
    }
    <span class="px-4 py-2">
      {page.currentPage} / {page.lastPage}
    </span>
    {
      page.url.next ? (
        <a href={page.url.next} class="rounded bg-gray-100 px-4 py-2 hover:bg-gray-200">
          下一页
        </a>
      ) : null
    }
  </nav>
</BaseLayout>
