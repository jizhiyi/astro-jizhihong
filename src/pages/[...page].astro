---
import Pagination from "@/components/Pagination.astro";
import PostList from "@/components/PostList.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { getSortedPosts } from "@/lib/content/blog-utils";
import type { Page, PaginateFunction } from "astro";
import type { CollectionEntry } from "astro:content";

type Props = {
  page: Page<CollectionEntry<"blog">>;
};

export async function getStaticPaths({ paginate }: { paginate: PaginateFunction }) {
  const posts = await getSortedPosts();
  return paginate(posts, { pageSize: 6 });
}

const { page } = Astro.props;
---

<BaseLayout title="Astro Blog" description="我的技术博客">
  <section class="mb-12">
    <h1 class="mb-4 text-4xl font-bold">欢迎来到我的博客</h1>
    <p class="text-muted-foreground">分享技术笔记、生活感悟和学习心得</p>
  </section>

  <PostList posts={page.data} showCategory={true} />

  <Pagination page={page} />
</BaseLayout>
