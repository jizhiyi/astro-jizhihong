---
const navItems = [
  { href: "/", label: "首页" },
  { href: "/blog", label: "博客" },
  { href: "/about", label: "关于" },
];
---

<header class="border-border border-b">
  <nav class="container mx-auto flex items-center justify-between px-4 py-4">
    <a href="/" class="text-xl font-bold">My Blog</a>
    <ul class="flex gap-6">
      {
        navItems.map(item => (
          <li>
            <a href={item.href} class="hover:text-primary transition-colors">
              {item.label}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
</header>
